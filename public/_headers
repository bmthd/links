# Cloudflare Workers static assets の _headers。/assets/(Vite)と /fonts/
# (scripts/generate-fonts.ts)はファイル名にコンテンツハッシュを含むので
# immutable キャッシュにできる。
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# プロフィール API(scripts/generate-api.ts)。ほかのサイトがブラウザから読める
# ように CORS を開け、デプロイで中身が変わるので短めにキャッシュする。
/profile.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/avatar-192.webp
  Access-Control-Allow-Origin: *
